# SecureLens AI - Frontend Environment Configuration Example (Vite)
# Copy to .env or .env.local for local frontend builds

# Backend API endpoint URL (production example: https://api.securelens.ai/api/analyze)
VITE_DETECTION_API_URL=https://api.securelens.ai/api/analyze

# Decision Thresholds (matching backend policy)
VITE_AI_HIGH_THRESHOLD=0.70
VITE_AI_LOW_THRESHOLD=0.30
VITE_DEEPFAKE_HIGH_THRESHOLD=0.50