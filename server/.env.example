# SecureLens AI - Express Backend Production Environment Configuration
# Copy to server/.env for local backend testing or configure in your production host (e.g. Render, Railway, AWS)

NODE_ENV=production
PORT=5000

# CORS Allowed Frontend Domain(s) - comma-separated list if multiple
FRONTEND_URL=https://app.securelens.ai
ALLOWED_ORIGIN=https://app.securelens.ai

# Sightengine Detector Credentials (SERVER-SIDE ONLY - NEVER LEAK TO CLIENT)
SIGHTENGINE_API_USER=your_sightengine_api_user_here
SIGHTENGINE_API_SECRET=your_sightengine_api_secret_here

# Classification Decision Thresholds
AI_HIGH_THRESHOLD=0.70
AI_LOW_THRESHOLD=0.30
DEEPFAKE_HIGH_THRESHOLD=0.50
